# Managed by mac-setup (playbooks/agents-vm.yml). Hand edits are overwritten on re-run —
# change the playbook variables (or -e) and re-run instead. 0600: contains secrets
# when the Google OAuth client is configured below.

model:
  provider: {{ hermes_default_provider }}
  default: {{ hermes_default_model }}

approvals:
  mode: smart   # keep dangerous-command approval on — the prompt-injection guardrail

# Ansible's Jinja env trims the first newline after a block tag, so bare tags on their
# own lines emit nothing; loop bodies must carry their newline inside the body.
{% if local_llm_models | length > 0 %}providers:
  omlx:
    api: {{ local_llm_base_url }}
{% if local_llm_api_key | default('') %}    key_env: OMLX_API_KEY
{% endif %}
    models:   # exactly the configured set — /v1/models also lists TTS/STT
{% for m in local_llm_models %}      - {{ m }}
{% endfor %}    discover_models: false   # offer exactly the list above, not /v1/models' full set
{% else %}# No omlx provider yet: local_llm_models is empty. Add model IDs (from your
# oMLX /v1/models) and re-run to enable the local endpoint.

{% endif %}
{% if local_tts_model | default('') %}tts:   # voice replies via oMLX's OpenAI-compatible /audio/speech (key: VOICE_TOOLS_OPENAI_KEY)
  provider: openai
  openai:
    base_url: {{ local_llm_base_url }}
    model: {{ local_tts_model }}

{% endif %}
{% if local_stt_model | default('') %}stt:   # voice input via oMLX's /audio/transcriptions (endpoint: STT_OPENAI_BASE_URL in .env)
  provider: openai
  openai:
    model: {{ local_stt_model }}

{% endif %}
{%- if (google_oauth_client_id | default('') != '') and (google_oauth_client_secret | default('') != '') -%}
mcp_servers:
  google_workspace:
    command: "{{ agents_vm_home }}/.local/bin/workspace-mcp"
    args: ["--read-only", "--tools"{% for t in google_workspace_tools %}, "{{ t }}"{% endfor %}]
    env:
      GOOGLE_OAUTH_CLIENT_ID: "{{ google_oauth_client_id }}"
      GOOGLE_OAUTH_CLIENT_SECRET: {{ google_oauth_client_secret | quote }}

{% endif -%}