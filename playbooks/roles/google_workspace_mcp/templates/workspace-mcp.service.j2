[Unit]
Description=Google Workspace MCP server (agents VM) — OAuth 2.1 multi-user, LAN via this Mac's IP
After=network-online.target

[Service]
User={{ agents_vm_user }}
# GOOGLE_OAUTH_CLIENT_ID/SECRET live here (0600, per-key managed) — the server performs
# the Google code exchange itself in OAuth 2.1 mode and needs both to start.
EnvironmentFile={{ agents_vm_home }}/.config/workspace-mcp/env
# MCP_ENABLE_OAUTH21: multi-user bearer mode (per-account Google creds, disk-backed
# client registrations so restarts never force re-auth). OAUTHLIB_INSECURE_TRANSPORT:
# the consent callback is plain HTTP (LAN only). Host 0.0.0.0: OrbStack exposes it to
# the LAN and this Mac's loopback — the browser consent + dashboard callback need that.
# BASE_URI is the canonical URL in OAuth metadata and must match the mcp_servers url Hermes
# dials (127.0.0.1) — a localhost/127.0.0.1 mismatch aborts the auth flow (resource indicator).
# The redirect URI stays http://localhost:… because that exact string is registered on the
# Google Cloud OAuth client (reached from this Mac's browser via OrbStack port forwarding).
Environment=MCP_ENABLE_OAUTH21=true WORKSPACE_MCP_HOST=0.0.0.0 WORKSPACE_MCP_PORT={{ workspace_mcp_port }} OAUTHLIB_INSECURE_TRANSPORT=1 WORKSPACE_MCP_OAUTH_PROXY_STORAGE_BACKEND=disk GOOGLE_OAUTH_REDIRECT_URI=http://localhost:{{ workspace_mcp_port }}/oauth2callback WORKSPACE_MCP_BASE_URI={{ workspace_mcp_base_uri }}
# Per-service permission levels (google_workspace_permissions): --permissions <service>:<level>,
# e.g. gmail:drafts = draft box + labels/archive but no send; --read-only/--tools are mutually
# exclusive with it, so the level list is the whole access story.
ExecStart={{ agents_vm_home }}/.local/bin/workspace-mcp --transport streamable-http{{ (' --permissions ' ~ google_workspace_permissions | join(' ') if (google_workspace_permissions | length > 0) else '') }}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
