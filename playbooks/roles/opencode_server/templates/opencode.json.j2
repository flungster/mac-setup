{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{ opencode_default_model }}",
  "provider": {
    "anthropic": {
      "options": {"apiKey": {{ anthropic_api_key | to_json }}}
    }{% if local_llm_models | length > 0 %},
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (local)",
      "options": {
        "baseURL": "{{ local_llm_base_url }}"{% if local_llm_api_key | default('') %},
        "apiKey": {{ local_llm_api_key | to_json }}{% endif %}
      },
      "models": {
        {% for m in local_llm_models %}"{{ m }}": {"name": "{{ m }}"}{% if not loop.last %},{% endif %}
        {% endfor %}}
    }{% endif %}
  },
  "server": {"hostname": "127.0.0.1", "port": {{ opencode_port }}}
}
