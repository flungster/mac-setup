[Unit]
Description=OpenCode server (agents VM) — loopback only; driven by the Hermes bridge
After=network-online.target

[Service]
User={{ agents_vm_user }}
WorkingDirectory={{ agents_vm_workspace_guest_path }}
ExecStart={{ agents_vm_home }}/.opencode/bin/opencode serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
