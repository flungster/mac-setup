#!/usr/bin/env bash
# Stub xcode-select for offline playbook tests.

STUB_TOOL="xcode-select"
# shellcheck source=tests/stubs/_stub_state.sh
source "$(dirname "$0")/_stub_state.sh"

sub="${1:-}"
case "$sub" in
  -p)
    stub_log "-p"
    # A real CLT install completes in the background (user-driven dialog): after
    # --install, -p keeps failing until CLT_PENDING_POLLS (default 1) further
    # checks pass, then CLT counts as installed. This lets tests exercise the
    # wait loop in bootstrap.sh without real delays (pair with CLT_POLL_INTERVAL=0).
    pending="$(stub_get clt_pending)"
    if [ -n "$pending" ]; then
      if [ "$pending" -le 1 ]; then
        stub_set clt_pending ""
        stub_set clt 1
      else
        stub_set clt_pending "$((pending - 1))"
      fi
    fi
    if [ -n "$(stub_get xcode_version)" ]; then
      echo "/Applications/Xcode.app/Contents/Developer"
    elif [ -n "$(stub_get clt)" ]; then
      echo "/Library/Developer/CommandLineTools"
    else
      echo "xcode-select: error: no developer directory was found" >&2
      exit 1
    fi
    ;;

  --install)
    stub_log "--install"
    if [ -z "$(stub_get clt_pending)" ]; then stub_set clt_pending "${CLT_PENDING_POLLS:-1}"; fi
    echo "Installing Command Line Tools (stub)"
    ;;

  *)
    echo "stub xcode-select: unhandled subcommand: $sub" >&2
    exit 1
    ;;
esac

exit 0
