#!/usr/bin/env bash
# Stub curl for offline bootstrap tests. Logs the invocation, then emits the
# contents of $FAKE_BREW_INSTALLER (a script that plants a fake brew) when
# asked to fetch an http(s) URL. Anything else fails loudly on purpose.

STUB_TOOL="curl"
# shellcheck source=tests/stubs/_stub_state.sh
source "$(dirname "$0")/_stub_state.sh"

stub_log "$@"

# Parse args: the first http(s) URL, and an output file if -o/--output was given
# (bootstrap downloads the Homebrew installer with `curl ... -o <tmpfile>`).
url="" out_file="" want_out=0 a
for a in "$@"; do
  if [ "$want_out" -eq 1 ]; then out_file="$a"; want_out=0; continue; fi
  case "$a" in
    -o) want_out=1 ;;
    --output=?*) out_file="${a#--output=}" ;;
    http://* | https://*) url="$a" ;;
  esac
done

if [ -z "$url" ]; then
  echo "stub curl: no URL in args ($*)" >&2
  exit 1
fi

if [ -z "${FAKE_BREW_INSTALLER:-}" ] || [ ! -f "$FAKE_BREW_INSTALLER" ]; then
  echo "stub curl: FAKE_BREW_INSTALLER is not set or unreadable (requested $url)" >&2
  exit 1
fi

if [ -n "$out_file" ]; then cat "$FAKE_BREW_INSTALLER" >"$out_file"; else cat "$FAKE_BREW_INSTALLER"; fi
exit 0
